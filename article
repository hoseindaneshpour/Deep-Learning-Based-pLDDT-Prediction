import pandas as pd
import numpy as np
import tensorflow as tf

import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split, KFold
from sklearn.preprocessing import OneHotEncoder, StandardScaler

from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score
)

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import (
    Dense,
    Dropout,
    BatchNormalization,
    GaussianNoise
)

from tensorflow.keras.callbacks import (
    EarlyStopping,
    ReduceLROnPlateau
)

from tensorflow.keras.regularizers import l2


#  the "B Factor" column in this dataset represents AlphaFold pLDDT values
#   
# Load data as explained in the data section of the article
# ======================================================

data = pd.read_csv(
    "file from my innovative dataframe.csv"
)



# == 
# Train/Test split
# ================= 

train_data, test_data = train_test_split(
    data,
    test_size=0.2,
    random_state=42
)



#  
# Separate features and target
# ======================================================

X_all = train_data[
    [
        "Residue",
        "Residue ID",
        "position",
        "weights_collection"
    ]
]


y_all = train_data[
    "B Factor"
].values



X_test_raw = test_data[
    [
        "Residue",
        "Residue ID",
        "position",
        "weights_collection"
    ]
]


y_test_original = test_data[
    "B Factor"
].values



# 
# Model function
# =========================== 

def create_model(input_dim):

    model = Sequential([


        GaussianNoise(
            0.05,
            input_shape=(input_dim,)
        ),



        Dense(
            128,
            activation="relu",
            kernel_regularizer=l2(0.001)
        ),

        BatchNormalization(),

        Dropout(0.5),



        Dense(
            64,
            activation="relu",
            kernel_regularizer=l2(0.001)
        ),

        BatchNormalization(),

        Dropout(0.4),



        Dense(
            32,
            activation="relu",
            kernel_regularizer=l2(0.001)
        ),

        Dropout(0.3),



        Dense(1)

    ])



    optimizer = tf.keras.optimizers.AdamW(
        learning_rate=0.0005,
        weight_decay=1e-4
    )



    model.compile(
        optimizer=optimizer,
        loss="mse",
        metrics=["mae"]
    )


    return model





#  
# K-Fold Cross Validation
# ======================== 

kf = KFold(
    n_splits=5,
    shuffle=True,
    random_state=42
)



cv_results = []



for fold, (train_idx, val_idx) in enumerate(
        kf.split(X_all)):


    print("\n====================")
    print("Fold", fold+1)
    print("====================")


    X_train_fold = X_all.iloc[train_idx]
    X_val_fold = X_all.iloc[val_idx]


    y_train_fold = y_all[train_idx]
    y_val_fold = y_all[val_idx]



    # --------------------------
    # One-hot encoding
    # --------------------------

    encoder = OneHotEncoder(
        sparse_output=False,
        handle_unknown="ignore"
    )


    residue_train = encoder.fit_transform(
        X_train_fold[["Residue"]]
    )


    residue_val = encoder.transform(
        X_val_fold[["Residue"]]
    )



    X_train_fold = np.hstack(
        [
            residue_train,
            X_train_fold[
                [
                    "Residue ID",
                    "position",
                    "weights_collection"
                ]
            ].values
        ]
    )


    X_val_fold = np.hstack(
        [
            residue_val,
            X_val_fold[
                [
                    "Residue ID",
                    "position",
                    "weights_collection"
                ]
            ].values
        ]
    )



    # ---------------- 
    # Feature scaling
    # ---------------- 

    scaler = StandardScaler()


    X_train_fold = scaler.fit_transform(
        X_train_fold
    )


    X_val_fold = scaler.transform(
        X_val_fold
    )



    # --------------- 
    # Target scaling
    # ---------------- 

    y_mean = y_train_fold.mean()

    y_std = y_train_fold.std()



    y_train_scaled = (
        y_train_fold-y_mean
    )/y_std



    y_val_scaled = (
        y_val_fold-y_mean
    )/y_std




    # ----- 
    # Model
    # ----- 

    model = create_model(
        X_train_fold.shape[1]
    )



    callbacks = [

        EarlyStopping(
            monitor="val_loss",
            patience=15,
            restore_best_weights=True
        ),


        ReduceLROnPlateau(
            monitor="val_loss",
            factor=0.3,
            patience=5,
            min_lr=1e-7
        )

    ]



    history = model.fit(

        X_train_fold,

        y_train_scaled,

        validation_data=
        (
            X_val_fold,
            y_val_scaled
        ),

        epochs=300,

        batch_size=32,

        callbacks=callbacks,

        verbose=0
    )




    # ---- 
    # Validation prediction
    # ---------------------- 

    prediction = model.predict(
        X_val_fold,
        verbose=0
    )



    prediction_original = (
        prediction.flatten()
        *
        y_std
        +
        y_mean
    )



    MAE = mean_absolute_error(
        y_val_fold,
        prediction_original
    )


    RMSE = np.sqrt(
        mean_squared_error(
            y_val_fold,
            prediction_original
        )
    )


    R2 = r2_score(
        y_val_fold,
        prediction_original
    )



    cv_results.append(
        [
            MAE,
            RMSE,
            R2
        ]
    )



    print(
        "MAE:",
        MAE
    )

    print(
        "RMSE:",
        RMSE
    )

    print(
        "R2:",
        R2
    )





#  
# Cross-validation summary
# =========================== 

cv_results = np.array(
    cv_results
)


print("\n========================")
print("5-Fold CV Results")
print("========================")


print(
    "MAE:",
    cv_results[:,0].mean(),
    "+/-",
    cv_results[:,0].std()
)


print(
    "RMSE:",
    cv_results[:,1].mean(),
    "+/-",
    cv_results[:,1].std()
)


print(
    "R2:",
    cv_results[:,2].mean(),
    "+/-",
    cv_results[:,2].std()
)





