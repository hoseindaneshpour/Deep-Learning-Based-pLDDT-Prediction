                "Residue ID",
                "position",
                "weights_collection"
            ]
        ].values
    ]
)




scaler_final = StandardScaler()


X_train_final = scaler_final.fit_transform(
    X_train_final
)


X_test_final = scaler_final.transform(
    X_test_final
)



# target scaling

y_mean_final = y_all.mean()

y_std_final = y_all.std()



y_train_final = (
    y_all-y_mean_final
)/y_std_final




# ===========  
# Final model
# ============ 

final_model = create_model(
    X_train_final.shape[1]
)



callbacks_final = [

    EarlyStopping(
        monitor="val_loss",
        patience=15,
        restore_best_weights=True
    ),


    ReduceLROnPlateau(
        monitor="val_loss",
        factor=0.3,
        patience=5
    )

]



history = final_model.fit(

    X_train_final,

    y_train_final,

    validation_split=0.2,

    epochs=300,

    batch_size=32,

    callbacks=callbacks_final,

    verbose=1
)



